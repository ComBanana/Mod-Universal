{
	"geode": "5.8.0",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "combanana2.mod-universal",
	"name": "Mod Universal",
	"version": "v0.0.1",
	"developer": "ComBanana2",
	"description": "A universal mod for just about everything.",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"settings": {
		"toggle-menu": {
			"type": "keybind",
			"name": "Toggle Mod Menu",
			"default": "F3",
			"category": "universal"
		},
		"noclip-enabled": {
			"type": "bool",
			"name": "Noclip",
			"default": false
		},
		"noclip-phase-blocks": {
			"type": "bool",
			"name": "Phase Through Blocks",
			"default": true,
			"enable-if": "noclip-enabled"
		},
		"noclip-block-mode": {
			"type": "string",
			"name": "Block Collision Mode",
			"default": "no-touch",
			"one-of": ["safe-touch", "no-touch"],
			"enable-if": "noclip-enabled && noclip-phase-blocks"
		},
		"noclip-phase-slopes": {
			"type": "bool",
			"name": "Phase Through Slopes",
			"default": true,
			"enable-if": "noclip-enabled"
		},
		"noclip-phase-hazards": {
			"type": "bool",
			"name": "Phase Through Hazards",
			"default": true,
			"enable-if": "noclip-enabled"
		},
		"noclip-hazard-spikes": {
			"type": "bool",
			"name": "Spikes",
			"default": true,
			"enable-if": "noclip-enabled && noclip-phase-hazards"
		},
		"noclip-hazard-ground-spikes": {
			"type": "bool",
			"name": "Ground / Edge Spikes",
			"default": true,
			"enable-if": "noclip-enabled && noclip-phase-hazards"
		},
		"noclip-hazard-saws": {
			"type": "bool",
			"name": "Sawblades",
			"default": true,
			"enable-if": "noclip-enabled && noclip-phase-hazards"
		},
		"noclip-hazard-pits": {
			"type": "bool",
			"name": "Pits",
			"default": true,
			"enable-if": "noclip-enabled && noclip-phase-hazards"
		},
		"noclip-hazard-animated": {
			"type": "bool",
			"name": "Animated Hazards",
			"default": true,
			"enable-if": "noclip-enabled && noclip-phase-hazards"
		},
		"noclip-hazard-other": {
			"type": "bool",
			"name": "Other Hazards",
			"default": true,
			"enable-if": "noclip-enabled && noclip-phase-hazards"
		}
	},
	"resources": {
		"sprites": [
			"resources/*.png"
		]
	}
}
